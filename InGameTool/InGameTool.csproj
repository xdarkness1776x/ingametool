<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.3.0.0</Version>
    <AssemblyName>InGameTool</AssemblyName>
    <Author>xdarkness1776x</Author>
    <Name>InGameTool Live Investigator</Name>
    <Punchline>Diagnose PlayerSync and Penumbra from inside FFXIV.</Punchline>
    <Description>On-demand, read-only character resource diagnostics with Desktop JSON reports. Penumbra public IPC, Dalamud plugin discovery, and PlayerSync status. No mod extraction.</Description>
    <RepoUrl>https://github.com/xdarkness1776x/ingametool</RepoUrl>
    <Tags>diagnostic;penumbra;playersync</Tags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
