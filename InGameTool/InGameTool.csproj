<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.1.1</Version>
    <Author>xdarkness1776x</Author>
    <Name>InGameTool</Name>
    <Punchline>Live Penumbra and PlayerSync diagnostics.</Punchline>
    <Description>Read-only, in-game Penumbra IPC resource scans and PlayerSync plugin compatibility checks. Saves JSON diagnostics to your Desktop only on request. Does not copy or download mods.</Description>
    <RepoUrl>https://github.com/xdarkness1776x/ingametool</RepoUrl>
    <Tags>diagnostics;penumbra;playersync</Tags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>